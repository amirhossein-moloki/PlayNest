# ==============================================================================
# PlayNest Shared & Infrastructure Environment Variables Template
# ==============================================================================

# --- General Application Settings ---
NODE_ENV="production"
APP_NAME="playenest"
PORT=3000
LOG_LEVEL="info"
TRUST_PROXY=1

# --- PostgreSQL Shared Database Credentials ---
POSTGRES_USER="playenest_admin"
POSTGRES_PASSWORD="change_this_secure_password_in_production"
POSTGRES_DB="playenest_prod"
PAYLOAD_POSTGRES_DB="payload_db"
POSTGRES_MULTIPLE_DATABASES="payload_db"

# --- Shared Redis Infrastructure ---
REDIS_URL="redis://redis:6379"

# --- Backup & Security (Restic) ---
RESTIC_PASSWORD="change_this_secure_restic_password"

# ==============================================================================
# Sayra Service Environment Variables
# ==============================================================================

# --- Sayra Database Connection URL ---
DATABASE_URL="postgresql://playenest_admin:change_this_secure_password_in_production@localhost:5432/playenest_prod"
PRISMA_LOG_QUERIES=false

# --- Sayra Authentication & JWT Security ---
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="generate_at_least_32_chars_long_random_string"
JWT_REFRESH_SECRET="generate_another_at_least_32_chars_long_random_string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Static API Key for middleware authentication (x-api-key header)
STATIC_API_KEY="generate_a_secure_api_key_at_least_10_chars"

# Optional cookie secret for signed cookies
COOKIE_SECRET="generate_a_secure_cookie_secret_at_least_10_chars"

# --- Sayra Webhooks ---
PAYMENT_PROVIDER_WEBHOOK_SECRET="generate_a_secure_webhook_secret"

# --- Sayra ZarinPal (Payment Gateway) ---
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_CALLBACK_URL="http://YOUR_SERVER_IP/api/v1/payments/callback"
ZARINPAL_SANDBOX=true

# --- Sayra CORS Settings ---
CORS_ORIGIN="*"
CORS_CREDENTIALS=true

# --- Sayra Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE="redis"
RATE_LIMIT_POINTS=10
RATE_LIMIT_DURATION=1
RATE_LIMIT_BLOCK_DURATION=60

# --- Sayra Media Storage ---
MEDIA_STORAGE_DRIVER="local" # "local" or "s3"
MEDIA_PUBLIC_BASE_URL="http://YOUR_SERVER_IP"
MEDIA_LOCAL_ROOT="storage"
MEDIA_LOCAL_PUBLIC_PATH="/media"

# S3 Settings (Required if MEDIA_STORAGE_DRIVER="s3")
# MEDIA_S3_BUCKET=""
# MEDIA_S3_REGION=""
# MEDIA_S3_UPLOAD_URL_TEMPLATE=""

# --- Sayra Sentry (Optional Error Tracking) ---
SENTRY_ENABLED=false
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- Sayra SMS Service (Smsir.ir) ---
SMSIR_API_KEY=""
SMSIR_LINE_NUMBER="100000"
SMSIR_OTP_TEMPLATE_ID="100000"
SMSIR_RESERVATION_PENDING_TEMPLATE_ID=""
SMSIR_RESERVATION_CONFIRMED_TEMPLATE_ID=""
SMSIR_RESERVATION_CANCELED_TEMPLATE_ID=""
SMSIR_OWNER_RESERVATION_CREATED_TEMPLATE_ID=""

# --- Sayra SMTP / Email Configuration (Optional) ---
# SAYRA_SMTP_HOST="smtp.example.com"
# SAYRA_SMTP_PORT=587
# SAYRA_SMTP_USER="sayra-user"
# SAYRA_SMTP_PASSWORD="sayra-password"
# SAYRA_SMTP_SECURE=false
# SAYRA_SMTP_FROM_EMAIL="noreply@playenest.com"
# SAYRA_SMTP_FROM_NAME="PlayNest Sayra"
# SAYRA_SMTP_REPLY_TO="support@playenest.com"

# ==============================================================================
# Payload CMS Environment Variables
# ==============================================================================

# --- Payload Database URI ---
DATABASE_URI="postgresql://playenest_admin:change_this_secure_password_in_production@localhost:5432/payload_db"
PAYLOAD_DB_PUSH=true

# --- Payload Security Secret ---
PAYLOAD_SECRET="generate_a_secure_payload_secret_at_least_32_chars"

# --- Payload SMTP / Email Configuration (Optional) ---
# PAYLOAD_SMTP_HOST="smtp.example.com"
# PAYLOAD_SMTP_PORT=587
# PAYLOAD_SMTP_USER="payload-user"
# PAYLOAD_SMTP_PASSWORD="payload-password"
# PAYLOAD_SMTP_SECURE=false
# PAYLOAD_SMTP_FROM_ADDRESS="cms@playenest.com"
# PAYLOAD_SMTP_FROM_NAME="PlayNest CMS"
