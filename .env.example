# ==============================================================================
# PlayNest Infrastructure Environment Variables Template
# ==============================================================================

# --- General Application Settings ---
NODE_ENV="production"
APP_NAME="playenest"
PORT=3000
LOG_LEVEL="info"
TRUST_PROXY=1

# --- Domain & Routing Settings ---
PLAYNEST_DOMAIN="playnest.com"
BLOG_DOMAIN="blog.playnest.com"

# --- PostgreSQL Database Credentials ---
POSTGRES_USER="playenest_admin"
POSTGRES_PASSWORD="<YOUR_SECURE_POSTGRES_PASSWORD>"
POSTGRES_DB="playenest_prod"
POSTGRES_MULTIPLE_DATABASES="blog_prod"

# --- Redis Infrastructure ---
REDIS_URL="redis://redis:6379"

# --- Backup & Security (Restic) ---
RESTIC_PASSWORD="<YOUR_SECURE_RESTIC_PASSWORD>"

# ==============================================================================
# Sayra Service Environment Variables
# ==============================================================================

# --- Sayra Database Connection URL ---
DATABASE_URL="postgresql://playenest_admin:<YOUR_SECURE_POSTGRES_PASSWORD>@db:5432/playenest_prod"
PRISMA_LOG_QUERIES=false

# --- Sayra Authentication & JWT Security ---
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="<YOUR_JWT_ACCESS_SECRET_MIN_32_CHARS>"
JWT_REFRESH_SECRET="<YOUR_JWT_REFRESH_SECRET_MIN_32_CHARS>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Optional cookie secret for signed cookies
COOKIE_SECRET="<YOUR_COOKIE_SECRET_MIN_10_CHARS>"

# --- Sayra Webhooks ---
PAYMENT_PROVIDER_WEBHOOK_SECRET="<YOUR_WEBHOOK_SECRET>"

# --- Sayra Payment Gateway Settings ---
DEFAULT_PAYMENT_PROVIDER="ZIBAL"

# Zibal Payment Gateway
ZIBAL_MERCHANT="zibal"
ZIBAL_CALLBACK_URL="https://api.sayra-booking.ir/api/v1/payments/zibal/callback"

# ZarinPal (Legacy / Alternative)
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_CALLBACK_URL="https://api.sayra-booking.ir/api/v1/payments/callback"
ZARINPAL_SANDBOX=true

# Frontend / Payment Redirects
FRONTEND_URL="https://sayra-booking.ir"
PAYMENT_SUCCESS_URL="https://sayra-booking.ir/payment/success"
PAYMENT_FAILED_URL="https://sayra-booking.ir/payment/failed"

# --- Sayra CORS Settings ---
CORS_ORIGIN="*"
CORS_CREDENTIALS=true

# --- Sayra Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE="redis"
RATE_LIMIT_POINTS=10
RATE_LIMIT_DURATION=1
RATE_LIMIT_BLOCK_DURATION=60

# --- OTP Authentication Settings ---
SKIP_OTP=false
OTP_MAX_ATTEMPTS=5
OTP_EXPIRATION_MINUTES=2
OTP_REQUEST_RATE_LIMIT_PHONE=3
OTP_REQUEST_RATE_LIMIT_IP=10

# --- Sayra Media Storage ---
MEDIA_STORAGE_DRIVER="local" # "local" or "s3"
MEDIA_PUBLIC_BASE_URL="https://playnest.com"
MEDIA_LOCAL_ROOT="storage"
MEDIA_LOCAL_PUBLIC_PATH="/media"

# S3 Settings (Required if MEDIA_STORAGE_DRIVER="s3")
# MEDIA_S3_BUCKET=""
# MEDIA_S3_REGION=""
# MEDIA_S3_UPLOAD_URL_TEMPLATE=""

# --- Sayra Sentry (Optional Error Tracking) ---
SENTRY_ENABLED=false
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- Sayra SMS Service (Smsir.ir) ---
SMSIR_API_KEY=""
SMSIR_LINE_NUMBER="100000"
SMSIR_OTP_TEMPLATE_ID="100000"
SMSIR_RESERVATION_PENDING_TEMPLATE_ID=""
SMSIR_RESERVATION_CONFIRMED_TEMPLATE_ID=""
SMSIR_RESERVATION_CANCELED_TEMPLATE_ID=""
SMSIR_OWNER_RESERVATION_CREATED_TEMPLATE_ID=""

# --- Melipayamak SMS Service ---
MELIPAYAMAK_USERNAME=""
MELIPAYAMAK_PASSWORD=""
MELIPAYAMAK_FROM=""
MELIPAYAMAK_OTP_BODY_ID=""
MELIPAYAMAK_RESERVATION_BODY_ID=""

# --- Sayra SMTP / Email Configuration (Optional) ---
# SAYRA_SMTP_HOST="smtp.example.com"
# SAYRA_SMTP_PORT=587
# SAYRA_SMTP_USER="sayra-user"
# SAYRA_SMTP_PASSWORD="sayra-password"
# SAYRA_SMTP_SECURE=false
# SAYRA_SMTP_FROM_EMAIL="noreply@playenest.com"
# SAYRA_SMTP_FROM_NAME="PlayNest Sayra"
# SAYRA_SMTP_REPLY_TO="support@playenest.com"

# ==============================================================================
# Blog Service Environment Variables (Django)
# ==============================================================================
BLOG_POSTGRES_DB="blog_prod"
BLOG_SECRET_KEY="<YOUR_SECURE_DJANGO_SECRET_KEY>"
BLOG_DEBUG=False
BLOG_ALLOWED_HOSTS="localhost,127.0.0.1,blog.playnest.com"
BLOG_CSRF_TRUSTED_ORIGINS="http://localhost,http://127.0.0.1,http://blog.playnest.com,https://blog.playnest.com"
BLOG_CORS_ALLOWED_ORIGINS="http://localhost,http://127.0.0.1,http://localhost:3000,http://blog.playnest.com,https://blog.playnest.com,http://playnest.com,https://playnest.com"
BLOG_CORS_ALLOW_ALL_ORIGINS=False
BLOG_CORS_ALLOW_CREDENTIALS=True
