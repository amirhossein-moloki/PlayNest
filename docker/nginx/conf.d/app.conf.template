upstream sayra_backend {
    server sayra:3000;
}

upstream blog_backend {
    server blog_web:8000;
}

# Rate limiting zone for API endpoints
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

# ----------------------------------------------------------------------
# 1. Blog Subdomain Virtual Host (e.g. blog.sayra-booking.ir)
# ----------------------------------------------------------------------
server {
    listen 80;
    server_name ${BLOG_DOMAIN};

    client_max_body_size 100M;

    # Blog Static Files
    location /static/ {
        alias /app/blog_static/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # Blog Media Files
    location /media/ {
        alias /app/blog_media/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # Django / Daphne ASGI application & Channels WebSockets
    location / {
        proxy_pass http://blog_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_redirect off;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# ----------------------------------------------------------------------
# 2. Sayra API Subdomain Virtual Host (e.g. api.sayra-booking.ir)
# ----------------------------------------------------------------------
server {
    listen 80;
    server_name ${API_DOMAIN};

    client_max_body_size 50M;

    # Static Media Files - Sayra
    location ${MEDIA_LOCAL_PUBLIC_PATH} {
        alias /app/storage;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # User uploads directory served via Sayra Express app
    location /uploads/ {
        proxy_pass http://sayra_backend/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 30d;
        add_header Cache-Control "public, no-transform";

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Sayra API routes (/api/v1 and /api/reservations)
    location /api/v1/ {
        limit_req zone=api_limit burst=20 nodelay;

        proxy_pass http://sayra_backend/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /api/reservations/ {
        limit_req zone=api_limit burst=20 nodelay;

        proxy_pass http://sayra_backend/api/v1/reservations/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Health Checks & Documentation (Sayra)
    location /health {
        proxy_pass http://sayra_backend/health;
        access_log off;
    }

    location /api-docs {
        proxy_pass http://sayra_backend/api-docs;
    }

    location /swagger {
        proxy_pass http://sayra_backend/swagger;
    }

    location /redoc {
        proxy_pass http://sayra_backend/redoc;
    }

    location /redoc-assets {
        proxy_pass http://sayra_backend/redoc-assets;
    }

    location /docs {
        proxy_pass http://sayra_backend/docs;
    }

    location /openapi.yaml {
        proxy_pass http://sayra_backend/openapi.yaml;
    }

    location /openapi.json {
        proxy_pass http://sayra_backend/openapi.json;
    }

    # Root route for API domain
    location = / {
        default_type application/json;
        return 200 '{"status":"ok","service":"Sayra Backend API","version":"1.0.0","docs":"/swagger/"}';
    }
}

# ----------------------------------------------------------------------
# 3. Main PlayNest Domain Virtual Host (sayra-booking.ir / fallback IP _)
# ----------------------------------------------------------------------
server {
    listen 80 default_server;
    server_name ${PLAYNEST_DOMAIN} www.${PLAYNEST_DOMAIN} _;

    client_max_body_size 50M;

    # Static Media Files - Sayra
    location ${MEDIA_LOCAL_PUBLIC_PATH} {
        alias /app/storage;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # User uploads directory served via Sayra Express app
    location /uploads/ {
        proxy_pass http://sayra_backend/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 30d;
        add_header Cache-Control "public, no-transform";

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Sayra API routes (/api/v1 and /api/reservations) for direct IP fallback
    location /api/v1/ {
        limit_req zone=api_limit burst=20 nodelay;

        proxy_pass http://sayra_backend/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /api/reservations/ {
        limit_req zone=api_limit burst=20 nodelay;

        proxy_pass http://sayra_backend/api/v1/reservations/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Health Checks & Docs (Sayra)
    location /health {
        proxy_pass http://sayra_backend/health;
        access_log off;
    }

    location /api-docs {
        proxy_pass http://sayra_backend/api-docs;
    }

    location /swagger {
        proxy_pass http://sayra_backend/swagger;
    }

    location /redoc {
        proxy_pass http://sayra_backend/redoc;
    }

    location /redoc-assets {
        proxy_pass http://sayra_backend/redoc-assets;
    }

    location /docs {
        proxy_pass http://sayra_backend/docs;
    }

    location /openapi.yaml {
        proxy_pass http://sayra_backend/openapi.yaml;
    }

    location /openapi.json {
        proxy_pass http://sayra_backend/openapi.json;
    }

    # ------------------------------------------------------------------
    # Blog Service Proxy & Asset Paths (Direct IP Access Support)
    # ------------------------------------------------------------------
    # Blog OpenAPI Schema & Swagger UI
    location /blog/api/schema/ {
        rewrite ^/blog/api/schema/(.*) /api/schema/$1 break;
        proxy_pass http://blog_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Blog Django Admin Panel
    location /admin/ {
        proxy_pass http://blog_backend/admin/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_redirect off;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Blog Static Files (needed for Admin and Swagger UI when accessed via IP)
    location /static/ {
        alias /app/blog_static/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # Blog Media Files (Direct read from blog media volume)
    location /blog_media/ {
        alias /app/blog_media/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # Default / Root Route (Placeholder for future frontend)
    location = / {
        default_type application/json;
        return 200 '{"status":"ok","service":"PlayNest Infrastructure Gateway","sayra":"http://api.sayra-booking.ir/api/v1","blog":"http://blog.sayra-booking.ir/"}';
    }
}
