map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

upstream sayra_backend {
    least_conn;
    server sayra:3000;
    keepalive 32;
}

upstream blog_backend {
    server blog_web:8000;
    keepalive 16;
}

# Extract real client IP only from trusted internal Docker networks & Cloudflare edge ranges.
# Keep these CIDRs strictly restricted to actual trusted reverse proxies/CDNs in front of Nginx.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 127.0.0.1/32;
set_real_ip_from ::1;
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Rate limiting zone for API endpoints (exempting internal SSR requests via x-ssr-secret header; fail-closed on empty or placeholder values)
map $http_x_ssr_secret $limit_key {
    ""                                   $binary_remote_addr;
    "__disabled_ssr_secret_never_match__" $binary_remote_addr;
    "${INTERNAL_SSR_SECRET}"             "";
    default                              $binary_remote_addr;
}
limit_req_zone $limit_key zone=api_limit:10m rate=60r/s;
limit_req_zone $binary_remote_addr zone=auth_admin_limit:10m rate=2r/s;
limit_req_status 429;

# ----------------------------------------------------------------------
# 0. HTTP -> HTTPS Redirect Gateway (Plaintext Disabled Outside /health)
# ----------------------------------------------------------------------
server {
    listen 80 default_server;
    server_name ${BLOG_DOMAIN} ${API_DOMAIN} ${PLAYNEST_DOMAIN} www.${PLAYNEST_DOMAIN} _;
    server_tokens off;

    location = /health {
        proxy_pass http://sayra_backend/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ----------------------------------------------------------------------
# 1. Blog Subdomain Virtual Host (e.g. blog.sayra-booking.ir)
# ----------------------------------------------------------------------
server {
    listen 443 ssl;

    server_name ${BLOG_DOMAIN};
    server_tokens off;

    ssl_certificate /etc/nginx/ssl/origin.pem;
    ssl_certificate_key /etc/nginx/ssl/origin-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    include /etc/nginx/snippets/security-headers.conf;

    client_max_body_size 100M;

    # Disallow crawling/indexing of headless blog API origin
    location = /robots.txt {
        default_type text/plain;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Blog Static Files
    location /static/ {
        alias /app/blog_static/;
        expires 30d;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, no-transform";
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri =404;
    }

    # Blog Media Files (sandboxed to prevent active SVG/HTML script execution)
    location /media/ {
        alias /app/blog_media/;
        expires 30d;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, no-transform";
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        try_files $uri =404;
    }

    # Rate-limited authentication, admin, and cache health endpoints
    location /admin/ {
        limit_req zone=auth_admin_limit burst=15 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;

        proxy_pass http://blog_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_redirect off;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /api/token/ {
        limit_req zone=auth_admin_limit burst=15 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;

        proxy_pass http://blog_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_redirect off;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /health/ {
        limit_req zone=auth_admin_limit burst=15 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;

        proxy_pass http://blog_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_redirect off;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Django / Daphne ASGI application & Channels WebSockets
    location / {
        proxy_pass http://blog_backend;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_redirect off;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# ----------------------------------------------------------------------
# 2. Sayra API Subdomain Virtual Host (e.g. api.sayra-booking.ir)
# ----------------------------------------------------------------------
server {
    listen 443 ssl;

    server_name ${API_DOMAIN};
    server_tokens off;

    client_max_body_size 50M;

    ssl_certificate /etc/nginx/ssl/origin.pem;
    ssl_certificate_key /etc/nginx/ssl/origin-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    include /etc/nginx/snippets/security-headers.conf;

    # Disallow crawling/indexing of API origin
    location = /robots.txt {
        default_type text/plain;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Static Media Files - Sayra (sandboxed)
    location ${MEDIA_LOCAL_PUBLIC_PATH} {
        alias /app/storage;
        expires 30d;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, no-transform";
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        try_files $uri =404;
    }

    # Static User Uploads - Served directly by Nginx (sandboxed)
    location /uploads/ {
        alias /app/uploads/;
        expires 30d;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, no-transform";
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        try_files $uri =404;
    }

    # Rate-limited admin panel and authentication endpoints
    location /platform-admin-panel {
        limit_req zone=auth_admin_limit burst=15 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;

        proxy_pass http://sayra_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /api/v1/auth/ {
        limit_req zone=auth_admin_limit burst=15 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;

        proxy_pass http://sayra_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /api/v1/platform-admin/auth/ {
        limit_req zone=auth_admin_limit burst=15 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;

        proxy_pass http://sayra_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Sayra API routes (/api/ with rate limiting)
    location /api/ {
        limit_req zone=api_limit burst=120 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;

        proxy_pass http://sayra_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Catch-all: Route all other requests to Sayra Backend
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_pass http://sayra_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# ----------------------------------------------------------------------
# 3. Main PlayNest Domain Virtual Host (sayra-booking.ir / fallback IP _)
# ----------------------------------------------------------------------
server {
    listen 443 ssl default_server;
    server_name ${PLAYNEST_DOMAIN} www.${PLAYNEST_DOMAIN} _;
    server_tokens off;

    client_max_body_size 50M;

    ssl_certificate /etc/nginx/ssl/origin.pem;
    ssl_certificate_key /etc/nginx/ssl/origin-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    include /etc/nginx/snippets/security-headers.conf;

    # Static Media Files - Sayra (sandboxed)
    location ${MEDIA_LOCAL_PUBLIC_PATH} {
        alias /app/storage;
        expires 30d;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, no-transform";
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        try_files $uri =404;
    }

    # Static User Uploads - Served directly by Nginx (sandboxed)
    location /uploads/ {
        alias /app/uploads/;
        expires 30d;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, no-transform";
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        try_files $uri =404;
    }

    # Sayra API routes (/api/v1, /api/public, and /api/reservations)
    location /api/v1/ {
        limit_req zone=api_limit burst=120 nodelay;

        proxy_pass http://sayra_backend/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /api/public/ {
        limit_req zone=api_limit burst=120 nodelay;

        proxy_pass http://sayra_backend/api/public/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /api/reservations/ {
        limit_req zone=api_limit burst=120 nodelay;

        proxy_pass http://sayra_backend/api/v1/reservations/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Short Link Fast Redirect Routes (/r/:code and /s/:code)
    location /r/ {
        limit_req zone=api_limit burst=200 nodelay;

        proxy_pass http://sayra_backend/r/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
    }

    location /s/ {
        limit_req zone=api_limit burst=200 nodelay;

        proxy_pass http://sayra_backend/s/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
    }

    # Health Checks & Docs (Sayra)
    location /health {
        proxy_pass http://sayra_backend/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
    }

    location /api-docs {
        proxy_pass http://sayra_backend/api-docs;
    }

    location /swagger {
        proxy_pass http://sayra_backend/swagger;
    }

    location /redoc {
        proxy_pass http://sayra_backend/redoc;
    }

    location /redoc-assets {
        proxy_pass http://sayra_backend/redoc-assets;
    }

    location /docs {
        proxy_pass http://sayra_backend/docs;
    }

    location /openapi.yaml {
        proxy_pass http://sayra_backend/openapi.yaml;
    }

    location /openapi.json {
        proxy_pass http://sayra_backend/openapi.json;
    }

    # ------------------------------------------------------------------
    # Blog Service Proxy & Asset Paths
    # ------------------------------------------------------------------
    # Blog OpenAPI Schema & Swagger UI
    location /blog/api/schema/ {
        rewrite ^/blog/api/schema/(.*) /api/schema/$1 break;
        proxy_pass http://blog_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Blog Django Admin Panel (rate limited)
    location /admin/ {
        limit_req zone=auth_admin_limit burst=15 nodelay;
        include /etc/nginx/snippets/security-headers.conf;

        proxy_pass http://blog_backend/admin/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_redirect off;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Blog Static Files
    location /static/ {
        alias /app/blog_static/;
        expires 30d;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # Blog Media Files (sandboxed)
    location /blog_media/ {
        alias /app/blog_media/;
        expires 30d;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, no-transform";
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        try_files $uri =404;
    }

    # Default / Root Route (Placeholder for future frontend)
    location = / {
        default_type application/json;
        return 200 '{"status":"ok","service":"PlayNest Infrastructure Gateway","sayra":"https://api.sayra-booking.ir/api/v1","blog":"https://blog.sayra-booking.ir/"}';
    }
}
