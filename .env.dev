# ==============================================================================
# PlayNest Development Environment Variables (.env.dev)
# Zero-setup development configuration for local testing and Docker Compose dev
# ==============================================================================

# Infrastructure & Shared
NODE_ENV="development"
APP_NAME="playenest"
PORT=3000
LOG_LEVEL="debug"
TRUST_PROXY=0

POSTGRES_USER="playenest_admin"
POSTGRES_PASSWORD="change_this_secure_password_in_production"
POSTGRES_DB="playenest_prod"
PAYLOAD_POSTGRES_DB="payload_db"
POSTGRES_MULTIPLE_DATABASES="payload_db"

REDIS_URL="redis://localhost:6379"
RESTIC_PASSWORD="dev_restic_password_for_testing"

# Sayra Configuration
DATABASE_URL="postgresql://playenest_admin:change_this_secure_password_in_production@localhost:5432/playenest_prod"
PRISMA_LOG_QUERIES=false

JWT_ACCESS_SECRET="dev_access_secret_32_characters_minimum_length"
JWT_REFRESH_SECRET="dev_refresh_secret_32_characters_minimum_length"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

COOKIE_SECRET="dev_cookie_secret_key"
PAYMENT_PROVIDER_WEBHOOK_SECRET="dev_webhook_secret"

ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_CALLBACK_URL="http://localhost:3000/api/v1/payments/callback"
ZARINPAL_SANDBOX=true

CORS_ORIGIN="*"
CORS_CREDENTIALS=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE="memory"
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION=1
RATE_LIMIT_BLOCK_DURATION=60

MEDIA_STORAGE_DRIVER="local"
MEDIA_PUBLIC_BASE_URL="http://localhost:3000"
MEDIA_LOCAL_ROOT="storage"
MEDIA_LOCAL_PUBLIC_PATH="/media"

SENTRY_ENABLED=false

SMSIR_API_KEY=""
SMSIR_LINE_NUMBER="100000"
SMSIR_OTP_TEMPLATE_ID="100000"

# Payload Configuration
DATABASE_URI="postgresql://playenest_admin:change_this_secure_password_in_production@localhost:5432/payload_db"
PAYLOAD_DB_PUSH=true
PAYLOAD_SECRET="dev_payload_secret_32_characters_minimum_length"
