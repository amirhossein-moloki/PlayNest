# ==============================================================================
# PlayNest Development Environment Variables (.env.dev)
# Zero-setup development configuration for local testing and Docker Compose dev
# ==============================================================================

# Infrastructure & Shared
NODE_ENV="development"
APP_NAME="playenest"
PORT=3000
LOG_LEVEL="debug"
TRUST_PROXY=0

POSTGRES_USER="playenest_admin"
POSTGRES_PASSWORD="change_this_secure_password_in_production"
POSTGRES_DB="playenest_prod"

REDIS_URL="redis://localhost:6379"
RESTIC_PASSWORD="dev_restic_password_for_testing"

# Sayra Configuration
DATABASE_URL="postgresql://playenest_admin:change_this_secure_password_in_production@localhost:5432/playenest_prod"
PRISMA_LOG_QUERIES=false

JWT_ACCESS_SECRET="dev_access_secret_32_characters_minimum_length"
JWT_REFRESH_SECRET="dev_refresh_secret_32_characters_minimum_length"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

COOKIE_SECRET="dev_cookie_secret_key"
PLATFORM_ADMIN_TOTP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
PLATFORM_ADMIN_TOTP_ISSUER="PlayNest"
PLATFORM_ADMIN_ACCESS_EXPIRES_IN="15m"
PLATFORM_ADMIN_REFRESH_EXPIRES_IN="12h"
PLATFORM_ADMIN_CHALLENGE_TTL_SECONDS=300
PLATFORM_ADMIN_SETUP_TTL_SECONDS=600
ADMIN_SESSION_SECRET="dev_admin_session_secret_key_32_chars_min"
ADMIN_COOKIE_SECRET="dev_admin_cookie_secret_key_32_chars_min"
PAYMENT_PROVIDER_WEBHOOK_SECRET="dev_webhook_secret"

DEFAULT_PAYMENT_PROVIDER="ZIBAL"

ZIBAL_MERCHANT="zibal"
ZIBAL_CALLBACK_URL="https://api.sayra-booking.ir/api/v1/payments/zibal/callback"

ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_CALLBACK_URL="http://localhost:3000/api/v1/payments/callback"
ZARINPAL_SANDBOX=true

FRONTEND_URL="https://sayra-booking.ir"
PAYMENT_SUCCESS_URL="https://sayra-booking.ir/payment/success"
PAYMENT_FAILED_URL="https://sayra-booking.ir/payment/failed"

CORS_ORIGIN="*"
CORS_CREDENTIALS=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE="memory"
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION=1
RATE_LIMIT_BLOCK_DURATION=60

# Development/testing bypass only. When SKIP_OTP=true, all OTP flows accept static code 000000 and bypass SMS dispatch.
SKIP_OTP=false
OTP_MAX_ATTEMPTS=5
OTP_EXPIRATION_MINUTES=2
OTP_REQUEST_RATE_LIMIT_PHONE=3
OTP_REQUEST_RATE_LIMIT_IP=10

MEDIA_STORAGE_DRIVER="local"
MEDIA_PUBLIC_BASE_URL="http://localhost:3000"
MEDIA_LOCAL_ROOT="storage"
MEDIA_LOCAL_PUBLIC_PATH="/media"

SENTRY_ENABLED=false

SMSIR_API_KEY=""
SMSIR_LINE_NUMBER="100000"
SMSIR_OTP_TEMPLATE_ID="100000"

# Blog Configuration (Development)
BLOG_CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
BLOG_CORS_ALLOW_ALL_ORIGINS=True
BLOG_CORS_ALLOW_CREDENTIALS=True

# Blog <-> Express Integration (Development)
INTERNAL_SSR_SECRET="dev_internal_ssr_secret_key_12345"
INTERNAL_SERVICE_TOKEN="dev_internal_service_token_12345"
RANKING_BAYESIAN_M=3
RANKING_MIN_REVIEWS_DEFAULT=3
BLOG_WEBHOOK_URL="http://127.0.0.1:8000/api/integrations/webhooks/sayra-events/"
BLOG_WEBHOOK_SECRET="dev_sayra_blog_webhook_hmac_secret_12345"
INTEGRATION_OUTBOX_POLL_INTERVAL_MS=10000
INTEGRATION_OUTBOX_BATCH_SIZE=25
INTEGRATION_OUTBOX_ENABLED=true
SAYRA_API_BASE_URL="http://127.0.0.1:3000/api/v1"
SAYRA_API_CONNECT_TIMEOUT=2.0
SAYRA_API_READ_TIMEOUT=4.0
SAYRA_GAMECENTER_CACHE_TTL=300
SAYRA_GAMECENTER_STALE_TTL=86400
NEXT_REVALIDATE_URL="http://127.0.0.1:3001/api/revalidate"
NEXT_REVALIDATION_SECRET="dev_next_revalidation_secret_12345"
