# ==============================================================================
# PlayNest Infrastructure Development Environment Variables (.env.dev)
# ==============================================================================

# --- General Application Settings ---
NODE_ENV="development"
APP_NAME="playenest"
PORT=3000
LOG_LEVEL="info"
TRUST_PROXY=1

# --- PostgreSQL Shared Database Credentials ---
POSTGRES_USER="playenest_admin"
POSTGRES_PASSWORD="dev_secure_password_12345"
POSTGRES_DB="playenest_prod"
PAYLOAD_POSTGRES_DB="payload_db"
POSTGRES_MULTIPLE_DATABASES="payload_db"

# --- Database Connection URLs ---
# Sayra Database URL (Express Backend & Prisma)
DATABASE_URL="postgresql://playenest_admin:dev_secure_password_12345@localhost:5432/playenest_prod"
PRISMA_LOG_QUERIES=false

# Payload Database URI (Payload CMS & Drizzle/Postgres Adapter)
DATABASE_URI="postgresql://playenest_admin:dev_secure_password_12345@localhost:5432/payload_db"

# --- Payload CMS Security ---
PAYLOAD_SECRET="dev_payload_secret_key_32_characters_min"

# --- Shared Redis Infrastructure ---
REDIS_URL="redis://localhost:6379"

# --- Backup & Security (Restic) ---
RESTIC_PASSWORD="dev_restic_password_12345"

# --- JWT / Sayra Security ---
JWT_ACCESS_SECRET="dev_jwt_access_secret_key_32_chars_min_length"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_key_32_chars_min_length"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Static API Key for middleware authentication (x-api-key header)
STATIC_API_KEY="dev_static_api_key_1234567890"

# Optional cookie secret for signed cookies
COOKIE_SECRET="dev_cookie_secret_1234567890"

# --- Webhooks ---
PAYMENT_PROVIDER_WEBHOOK_SECRET="dev_webhook_secret_12345"

# --- ZarinPal (Payment) ---
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_CALLBACK_URL="http://localhost:3000/api/v1/payments/callback"
ZARINPAL_SANDBOX=true

# --- CORS ---
CORS_ORIGIN="*"
CORS_CREDENTIALS=true

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE="redis"
RATE_LIMIT_POINTS=10
RATE_LIMIT_DURATION=1
RATE_LIMIT_BLOCK_DURATION=60

# --- Media Storage ---
MEDIA_STORAGE_DRIVER="local" # "local" or "s3"
MEDIA_PUBLIC_BASE_URL="http://localhost:3000"
MEDIA_LOCAL_ROOT="storage"
MEDIA_LOCAL_PUBLIC_PATH="/media"

# S3 Settings (Required if MEDIA_STORAGE_DRIVER="s3")
# MEDIA_S3_BUCKET=""
# MEDIA_S3_REGION=""
# MEDIA_S3_UPLOAD_URL_TEMPLATE=""

# --- Sentry (Optional) ---
SENTRY_ENABLED=false
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- SMS Service (Smsir.ir) ---
SMSIR_API_KEY=""
SMSIR_LINE_NUMBER=""
SMSIR_OTP_TEMPLATE_ID="100000"

# Reservation template IDs
SMSIR_RESERVATION_PENDING_TEMPLATE_ID=""
SMSIR_RESERVATION_CONFIRMED_TEMPLATE_ID=""
SMSIR_RESERVATION_CANCELED_TEMPLATE_ID=""
